# Godot 4+ specific ignores
.godot/
/android/

# Generated by tools/preview.gd
/previews/

# Playtest notes written by the F2 debug key now go to user:// (outside the
# repo) so they survive an exported build. This rule catches notes left behind
# by an older build that wrote into res://logs.
/logs/

# Editor-local and machine-specific: the Godot binary path differs per machine,
# so a committed copy is wrong for everyone but its author.
/.vscode/

# macOS Finder droppings. No leading slash, so it matches at every level rather
# than only the repo root — assets/.DS_Store was tracked for exactly that
# reason.
.DS_Store
